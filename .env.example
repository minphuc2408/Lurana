# Public build-time key only; never put TURNSTILE_SECRET in a VITE_* variable.
# Public widget keys are separate: .env.production and .env.staging.
# npm run deploy:staging selects Vite staging mode automatically.
# VITE_TURNSTILE_SITE_KEY=replace-with-public-site-key
# VITE_SITE_URL=https://your-public-hostname.example
# VITE_SITE_INDEXABLE=false
