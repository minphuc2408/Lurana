# Default deny: only the reviewed files listed below may be added normally.
# Applies to every branch, including main. Update this list for new project files.
# This does not inspect file contents or stop git add -f.
*

# Allow traversal only through the current project directories.
!/guidelines/
!/src/
!/src/app/
!/src/app/components/
!/src/app/components/figma/
!/src/app/components/ui/
!/src/app/context/
!/src/app/pages/
!/src/styles/

