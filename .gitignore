**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.keystore
**/id_rsa*
**/id_ed25519*
**/credentials*
**/secrets.*
**/*.log
**/*.bak
**/*.tmp
**/*~
**/.DS_Store
**/Thumbs.db
**/node_modules/
/dist/
/.npm-cache/
/.security-review/
/.codegraph/
/SECURITY_REVIEW.md
**/.aws/
**/.ssh/
**/.agents/
**/.codex/

